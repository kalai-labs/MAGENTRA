{
  "name": "magentra-app",
  "version": "0.19.2",
  "private": true,
  "description": "MAGENTRA desktop app — the Electron shell around the agent engine.",
  "homepage": "https://github.com/kalai-labs/MAGENTRA",
  "author": "Kalai Labs <muhammetaliozturk.ofis@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/launch.js",
    "bundle:engine": "node scripts/bundle-engine.js",
    "dist": "node scripts/bundle-engine.js --target win && node scripts/dist.js --win",
    "dist:mac": "node scripts/bundle-engine.js --target mac && node scripts/dist.js --mac",
    "smoke": "node scripts/launch.js --smoke"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.magentra.app",
    "productName": "MAGENTRA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "scripts/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "kalai-labs",
        "repo": "MAGENTRA"
      }
    ],
    "files": [
      "package.json",
      {
        "from": "build-resources/app",
        "to": "."
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signExecutable": false,
      "extraResources": [
        {
          "from": "build-resources/engine",
          "to": "engine",
          "filter": [
            "engine.cjs",
            "doc-extract.mjs",
            "tui.mjs",
            "rg.exe"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "MAGENTRA-${version}-win-portable.exe"
    },
    "nsis": {
      "artifactName": "MAGENTRA-${version}-win-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "MAGENTRA-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "extraResources": [
        {
          "from": "build-resources/engine",
          "to": "engine",
          "filter": [
            "engine.cjs",
            "doc-extract.mjs",
            "tui.mjs",
            "rg"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
