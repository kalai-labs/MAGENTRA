node_modules/
dist/
out/
coverage/
*.tsbuildinfo

# desktop build artifacts
app/build-resources/
app/dist/
app/tests/.tmp/

# workspace state the engine writes
.magentra/

.env
.env.*
!.env.example

.DS_Store
*.log

.magentra/*
.claude/*
# Skills are project tooling and belong in the repo — everything else under
# .claude/ (settings.local.json, caches) stays ignored. Without this negation a
# new skill is silently untracked and only `git add -f` ever commits it.
!.claude/skills/
*.zip
*.exe
